      <script>
  
    function filter(page) {
        let category_id = (typeof $('#category').val() == 'undefined') ? '' : $('#category').val();
        // let price_range_start = $('#price_range_start').val();
        // let price_range_end = $('#price_range_end').val();
        let color_id = (typeof $('.select-color.highlight_color').attr('color_id') == 'undefined') ? '' : $('.select-color.highlight_color').attr('color_id');
        let fabric_type = (typeof $('.product-fabric-type.selected').attr('fabric_type') == 'undefined') ? '' : $('.product-fabric-type.selected').attr('fabric_type');
        let price_range = (typeof $('.product_price_range.selected').attr('price_range') == 'undefined') ? '' : $('.product_price_range.selected').attr('price_range');
        let attributes = $('.attributes:checked').map(function() {
            return $(this).val();
        }).toArray();

         let discount = $('.discounts:checked').map(function() {
            return $(this).val();
        }).toArray();

        let brands = $('.brands:checked').map(function() {
            return $(this).val();
        }).toArray();
       let rating = (typeof $('.rating:checked').val() == 'undefined') ? '' : $('.rating:checked').val();
          
        let url = `{{ URL::to('listing') }}`;
        let paraments = '?page=' + page + '&category=' + category_id + '&color=' + color_id + '&option_attributes=' + attributes + '&brands=' + brands + '&fabric_type=' + fabric_type + '&price_range=' + price_range + '&discounts=' + discount + '&rating=' + rating;
        window.location = url + paraments;
    }

    $(document).ready(function() {
          $(document).on('click', '.select-color', function(event) {
            $(".select-color").removeClass("highlight_color");
            $(this).addClass("highlight_color");
             let page = 1;
            filter(page);
        });

        $(document).on('click', '.attributes', function(event) {
            let page = 1;
            filter(page);
        });
         $(document).on('click', '.discounts', function(event) {
            let page = 1;
            filter(page);
        });
        $(document).on('click', '.brands', function(event) {
            let page = 1;
            filter(page);
        });

          $(document).on('click', '.product-fabric li', function(event) {
            $(".product-fabric li").removeClass('selected');
            $(this).addClass("selected");
            let page = 1;
            filter(page);
        });

           $(document).on('click', '.product_price li', function(event) {
            $(".product_price li").removeClass('selected');
            $(this).addClass("selected");
            let page = 1;
            filter(page);
        });
            $(document).on('click', '.rating', function(event) {
               $(this).addClass("checked");
            let page = 1;
            filter(page);
        })
         
    });
</script>
    @endsection